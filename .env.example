# Groq Cloud API Key for model completions (Required for live LLM; omit for offline fallback)
GROQ_API_KEY=your_groq_api_key_placeholder

# Groq API base URL endpoint
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Primary LLM model for nuanced boardroom interrogation dialogue and dossiers
GROQ_BIG_MODEL=openai/gpt-oss-120b

# Fast LLM model for real-time background diligence analysis and claim extraction
GROQ_SMALL_MODEL=openai/gpt-oss-20b

# Neon PostgreSQL pooled connection string (Required for persistent DB; omit for in-memory mock)
DATABASE_URL=postgresql://user:password@ep-sample-pool.neon.tech/neondb?sslmode=require

# Maximum allowed exchanges per interrogation session before transition to verdict
MAX_TURNS=14

# IP rate limiting requests per minute threshold on model calling routes
RATE_LIMIT_PER_MIN=30

# Feature Flag: Audio and intro onboarding experience on boardroom entry (true / false)
NEXT_PUBLIC_FEATURE_INTRO_GATE=false

# Feature Flag: Real-time investor reaction badges indicating mood shifts (true / false)
NEXT_PUBLIC_FEATURE_REACTIONS=false

# Feature Flag: 5-axis pitch radar visualization in the debrief dossier (true / false)
NEXT_PUBLIC_FEATURE_RADAR=false

# Feature Flag: Social share card generator for term sheets and readiness scores (true / false)
NEXT_PUBLIC_FEATURE_SHARE_CARD=false

# Feature Flag: Post-pitch "Behind Closed Doors" partner deliberation scene (true / false)
NEXT_PUBLIC_FEATURE_BEHIND_DOORS=false
